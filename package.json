{
  "name": "studymate",
  "version": "1.0.0",
  "description": "Personal Exam Preparation Manager",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:single": "npm run build && node backend/server.js",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "start": "npm run build && node backend/server.js",
    "prod": "node backend/server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "workspaces": [
    "frontend"
  ]
}
